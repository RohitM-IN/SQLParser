                  "=",
                  0
                ],
                "or",
                [
                  "CompanyID",
                  "=",
                  null,
                  {
                    "type": "ISNULL",
                    "position": "column",
                    "defaultValue": 0
                  },
                  null
                ],
                "or",
                [
                  "CompanyID",
                  "=",
                  false
                ]
              ]
            ],
            "and",
            [
              [
                "IsSubdealer",
                "=",
                false
              ],
              "or",
              [
                "IsSubdealer",
                "=",
                null,
                {
                  "type": "ISNULL",
                  "position": "column",
                  "defaultValue": 0
                },
                null
              ]
            ]
          ],
          "expectedSql": [
            "( \"CompanyID\" = 2 OR ( \"CompanyID\" = 0 OR ISNULL(\"CompanyID\", 0) = 0 OR \"CompanyID\" = 0 ) )",
            "AND ( \"IsSubdealer\" = 0 OR ISNULL(\"IsSubdealer\", 0) = 0 )"
