              "AllowSubDealer",
              "=",
              null,
              {
                "type": "ISNULL",
                "position": "column",
                "defaultValue": 1
              },
              null
            ]
          ],
          "expectedSql": "\"AllowSubDealer\" = 1 OR ISNULL(\"AllowSubDealer\", 1) = 1"
        },
        {
          "id": 51,
          "input": "ItemGroupType IN ({ItemPrice.AllowedItemGroupType}) AND ((ISNULL(IsNonStock,0))={ItemPrice.AllowedNonStock})  AND (CompanyID = {ItemPrice.CompanyID} OR {ItemPrice.CompanyID} = 0 OR ISNULL(CompanyID,0) = 0)",
          "filter": [
            [
              [
                [
                  "ItemGroupType",
                  "=",
                  "1"
                ],
                "or",
                [
                  "ItemGroupType",
                  "=",
                  "2"
                ]
              ],
              "and",
              [
                [
                  "IsNonStock",
                  "=",
                  1,
                  {
                    "type": "ISNULL",
                    "position": "column",
                    "defaultValue": 0
                  },
                  1
                ],
                "or",
                [
                  "IsNonStock",
                  "=",
                  true
                ]
              ]
            ],
            "and",
            [
              [
                "CompanyID",
                "=",
                7
              ],
              "or",
              [
                [
                  "CompanyID",
                  "=",
                  0
                ],
                "or",
                [
                  "CompanyID",
                  "=",
                  null,
                  {
                    "type": "ISNULL",
                    "position": "column",
                    "defaultValue": 0
                  },
                  null
                ],
                "or",
                [
                  "CompanyID",
                  "=",
                  false
                ]
              ]
            ]
          ],
          "expectedSql": [
            "( ( \"ItemGroupType\" = N'1' OR \"ItemGroupType\" = N'2' )",
            "AND ( ISNULL(\"IsNonStock\", 0) = 1 OR \"IsNonStock\" = 1 ) )",
            "AND ( \"CompanyID\" = 7 OR ( \"CompanyID\" = 0 OR ISNULL(\"CompanyID\", 0) = 0 OR \"CompanyID\" = 0 ) )"
          ]
        },
        {
          "id": 55,
          "input": "(ISNULL(ItemID,0) = {PurchaseOrderLine.ItemID}) AND (varID = ISNULL({PurchaseOrderLine.VarMatrixID0}, 0) OR ({PurchaseOrderLine.VarMatrixID0} = 0 AND ISNULL(varID, 0) = 0))",
          "filter": [
            [
              "ItemID",
              "=",
              42,
              {
                "type": "ISNULL",
                "position": "column",
                "defaultValue": 0
              },
              42
            ],
            "and",
            [
              [
                "varID",
                "=",
                null,
                {
                  "type": "ISNULL",
                  "position": "value",
